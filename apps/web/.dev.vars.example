NEXTJS_ENV=development
# Lokal zusätzlich die Demo-Konten (Tests melden sich damit an)
AUTH_METHODS=mock,planary,microsoft
# Microsoft-Login lokal (Werte aus der Entra-ID-App-Registrierung)
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# Zusätzliche erlaubte Domains zum Testen, kommagetrennt
# AUTH_EXTRA_DOMAINS=
# Lokal: Zeit auf den Stichtag der Beispieldaten (für Tests und Screenshots). Im Deployment gilt die echte Zeit.
DEMO_NOW=2026-10-26T10:20:00
# Interne API für admin.planary.ch (über planary-org): langer Zufallswert, lokal beliebig
# INTERNAL_KEY=
