{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "bwd-portal",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-Referenz für OpenNext, Name muss dem Worker entsprechen
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bwd-portal"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bwd-portal",
      // Erstellt mit `wrangler d1 create bwd-portal`
      "database_id": "7f331f3f-0e10-4a5f-8bc2-3fba0856cc2d",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      // Anhänge (Arztzeugnisse) und Dokumente
      "binding": "FILES",
      "bucket_name": "bwd-portal-files"
    }
  ],
  "vars": {
    // mock, microsoft oder both (Demo-Konten und Microsoft). Ohne MS_CLIENT_ID und Secret wie mock.
    "AUTH_MODE": "both",
    // Entra-ID-App-Registrierung (öffentlich). Das Secret MS_CLIENT_SECRET kommt per `wrangler secret put`.
    "MS_CLIENT_ID": "",
    "MS_TENANT": "common",
    "DEMO_NOW": "2026-10-26T10:20:00",
    // Öffentliche Adresse für Open Graph und Meta
    "SITE_URL": "https://bwd-portal.planary.workers.dev"
  }
}
