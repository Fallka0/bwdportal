{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "bwd-portal",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Eigene Domain (in Cloudflare eingerichtet). bwd-portal.planary.workers.dev bleibt zusätzlich erreichbar.
  "routes": [{ "pattern": "bwdportal.planary.ch", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-Referenz für OpenNext, Name muss dem Worker entsprechen
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bwd-portal"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bwd-portal",
      // Erstellt mit `wrangler d1 create bwd-portal`
      "database_id": "7f331f3f-0e10-4a5f-8bc2-3fba0856cc2d",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      // Anhänge (Arztzeugnisse) und Dokumente
      "binding": "FILES",
      "bucket_name": "bwd-portal-files"
    }
  ],
  "vars": {
    // Anmeldungen, kommagetrennt: planary (Planary-Konto), microsoft (Entra ID), mock (Demo-Konten, nur lokal in .dev.vars)
    "AUTH_METHODS": "planary,microsoft",
    // Planary-Login; bwdportal.planary.ch muss dort in ALLOWED_RETURN_TO_ORIGINS stehen
    "PLANARY_AUTH_URL": "https://auth.planary.ch",
    // Entra-ID-App-Registrierung (öffentlich). Das Secret MS_CLIENT_SECRET kommt per `wrangler secret put`.
    "MS_CLIENT_ID": "ed293a80-42f1-4cb8-bba6-623d341e28cb",
    "MS_TENANT": "common",
    // Zusätzlich erlaubte Konto-Domains zum Testen (neben der Schul-Domain), kommagetrennt. Im Deployment leer:
    // die SOL-Unterlagen sind Dokumente der Schule.
    "AUTH_EXTRA_DOMAINS": "",
    // Klasse für neue Konten (Microsoft und Planary), solange keine Zuordnung aus dem Schulsystem kommt
    "DEFAULT_CLASS": "IM24a",
    // Öffentliche Adresse für Open Graph und Meta
    "SITE_URL": "https://bwdportal.planary.ch"
  }
}
