# Kopieren nach .env.local (nie ins Repo). Nur für den lokalen Import.
# Servername und Schulname stehen in der WebUntis-Adresse, z. B. https://<server>/WebUntis/?school=<schule>
WEBUNTIS_SERVER=
WEBUNTIS_SCHOOL=
WEBUNTIS_USER=
# Am besten das Secret aus dem WebUntis-Profil (Freigaben, Zugriff über Untis Mobile), kein Passwort.
WEBUNTIS_SECRET=
# Alternative: QR-Daten (untis://setschool?...) oder Passwort
WEBUNTIS_QR=
WEBUNTIS_PASSWORD=
# Für --source ical: Adresse des Kalender-Abos aus dem WebUntis-Profil
ICAL_URL=
